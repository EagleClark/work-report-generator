{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-git-commit.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/remind-git-add.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/remind-workflow.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo '结束前检查工作流：brainstorm → TDD → implement → test → review → verify？已暂存的修改请提醒用户手动 git commit。'"
          }
        ]
      }
    ]
  }
}
